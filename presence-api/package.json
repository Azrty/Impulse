{
  "name": "@impulse/presence-api",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/data && cp data/recognized-mods.json dist/data/recognized-mods.json",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
    ,"mods:recognize": "node scripts/recognize-mod.mjs && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}

{
  "name": "@impulse/presence-api",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run validate:updates && tsc -p tsconfig.json && mkdir -p dist/data && cp data/*.json dist/data/",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:updates": "tsx scripts/validate-standalone-updates.ts",
    "mods:recognize": "node scripts/recognize-mod.mjs",
    "servers:block": "node scripts/manage-blocked-server.mjs",
    "servers:unblock": "node scripts/manage-blocked-server.mjs --remove"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
